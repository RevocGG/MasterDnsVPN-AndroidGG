    <string name="warn_reason_dns_cache_ram">هر رکورد DNS در رم ذخیره می‌شود. %1$s رکورد برای دستگاه شما (%2$s مگابایت رم) کافی است.</string>
    <string name="warn_reason_udp_pool">هر اتصال یک سوکت سیستمی اشغال می‌کند. کم کردن این مقدار فشار فایل‌دیسکریپتور و رم را کم می‌کند.</string>
    <string name="warn_reason_ping_interval">فاصله %1$s ثانیه یعنی بیش از %2$s پینگ در ثانیه و فشار روی CPU ضعیف.</string>
    <string name="warn_reason_zlib">ZLIB برای هر بسته CPU زیادی مصرف می‌کند و روی دستگاه‌های کمتر از ۴ هسته توصیه نمی‌شود.</string>
    <string name="warn_reason_log_level">سطح %1$s برای هر بسته رشته‌های بزرگ می‌سازد و روی دیسک می‌نویسد؛ CPU و I/O دستگاه را سنگین مصرف می‌کند.</string>
